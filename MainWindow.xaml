<Window x:Class="NetworkMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Home Network Monitor" Height="650" Width="1050" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal"><TextBlock Text="Home Network Monitor" FontSize="28" FontWeight="Bold"/><TextBlock Text="  v0.9.32" Foreground="Gray" VerticalAlignment="Bottom" Margin="12,0,0,7"/></StackPanel>
      <TextBlock Text="Nest Wifi Pro network • light monitoring every 15 minutes" Foreground="Gray"/>
      <UniformGrid Columns="4" Margin="0,18,0,12">
        <Border Background="#E8F1FF" Padding="12" Margin="4"><StackPanel><TextBlock Text="Total devices"/><TextBlock x:Name="TotalText" Text="0" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="#E9F8EE" Padding="12" Margin="4"><StackPanel><TextBlock Text="Online"/><TextBlock x:Name="OnlineText" Text="0" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="#FFF4DD" Padding="12" Margin="4"><StackPanel><TextBlock Text="Offline"/><TextBlock x:Name="OfflineText" Text="0" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="#FFE7E7" Padding="12" Margin="4"><StackPanel><TextBlock Text="Unknown / new"/><TextBlock x:Name="UnknownText" Text="0" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
      </UniformGrid>
      <StackPanel Orientation="Horizontal" Margin="4,0,4,12"><Button x:Name="ScanButton" Content="Scan now" Padding="18,8" Click="ScanButton_Click"/><Button Content="Advanced sort" Padding="12,8" Margin="8,0,0,0" Click="AdvancedSort_Click"/><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Margin="14,4"/><CheckBox x:Name="ShowMulticastCheckBox" Content="Show multicast addresses (224–239)" IsChecked="False" VerticalAlignment="Center" Margin="22,4,4,4" Checked="DisplayFilterChanged" Unchecked="DisplayFilterChanged"/></StackPanel>
      <Border x:Name="SortPanel" Visibility="Collapsed" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="4,0,4,8"><StackPanel Orientation="Horizontal"><TextBlock Text="Primary:" VerticalAlignment="Center"/><ComboBox x:Name="PrimarySortBox" Width="130" Margin="5,0,12,0"><ComboBoxItem Content="Type"/><ComboBoxItem Content="Name"/><ComboBoxItem Content="Managed by"/><ComboBoxItem Content="IP address"/><ComboBoxItem Content="Manufacturer"/><ComboBoxItem Content="First seen"/><ComboBoxItem Content="Last seen"/></ComboBox><ComboBox x:Name="PrimaryDirectionBox" Width="105" Margin="0,0,12,0"><ComboBoxItem Content="Ascending"/><ComboBoxItem Content="Descending"/></ComboBox><TextBlock Text="Secondary:" VerticalAlignment="Center"/><ComboBox x:Name="SecondarySortBox" Width="130" Margin="5,0,12,0"><ComboBoxItem Content="Name"/><ComboBoxItem Content="Type"/><ComboBoxItem Content="Managed by"/><ComboBoxItem Content="IP address"/><ComboBoxItem Content="Manufacturer"/><ComboBoxItem Content="First seen"/><ComboBoxItem Content="Last seen"/></ComboBox><ComboBox x:Name="SecondaryDirectionBox" Width="105" Margin="0,0,12,0"><ComboBoxItem Content="Ascending"/><ComboBoxItem Content="Descending"/></ComboBox><TextBlock Text="Third:" VerticalAlignment="Center"/><ComboBox x:Name="ThirdSortBox" Width="130" Margin="5,0,12,0"><ComboBoxItem Content="Name"/><ComboBoxItem Content="Type"/><ComboBoxItem Content="Managed by"/><ComboBoxItem Content="IP address"/><ComboBoxItem Content="Manufacturer"/><ComboBoxItem Content="First seen"/><ComboBoxItem Content="Last seen"/></ComboBox><ComboBox x:Name="ThirdDirectionBox" Width="105" Margin="0,0,12,0"><ComboBoxItem Content="Ascending"/><ComboBoxItem Content="Descending"/></ComboBox><Button Content="Apply" Padding="12,4" Click="ApplyAdvancedSort_Click"/></StackPanel></Border><TextBlock Text="Recent changes" FontWeight="Bold" Margin="4,0,4,2"/><TextBlock x:Name="RecentChangesText" Text="No changes recorded yet." Foreground="Gray" Margin="4,0,4,10"/>
    </StackPanel>
    <GroupBox DockPanel.Dock="Bottom" Header="Selected device" Margin="0,12,0,0" Padding="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition Width="250"/><ColumnDefinition Width="130"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <TextBlock Text="Name" Grid.Column="0" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Height="24" VerticalAlignment="Top" Margin="4" TextChanged="EditorChanged"/><TextBlock Text="Managed by" Grid.Column="2" VerticalAlignment="Center"/><ComboBox x:Name="ManagedByBox" Grid.Column="3" Height="28" VerticalAlignment="Top" IsEditable="True" Margin="4"/><Button x:Name="AddServiceButton" Content="Add service" Grid.Column="4" Width="94" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0" FontSize="11" Click="AddManagedBy_Click" IsEnabled="False"/><StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0"><TextBlock Text="Owner" VerticalAlignment="Center" Margin="0,6,5,0"/><TextBox x:Name="OwnerBox" Width="170" Height="24" Margin="0,6,0,0" TextChanged="EditorChanged"/></StackPanel>
        <TextBlock Text="Type" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Height="24" VerticalAlignment="Top" Margin="4" TextChanged="EditorChanged"/><TextBlock Text="Notes" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="3" Height="24" VerticalAlignment="Top" Margin="4" TextChanged="EditorChanged"/><ComboBox x:Name="IdentityModeBox" Grid.Row="1" Grid.Column="4" Height="28" VerticalAlignment="Top" Margin="4" SelectionChanged="EditorChanged"><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Track by IP"/><ComboBoxItem Content="Track by MAC"/></ComboBox><Button x:Name="SaveButton" Content="Save details" Grid.Row="1" Grid.Column="5" Width="110" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="48,0,0,0" Click="SaveDetails_Click" IsEnabled="False"/>
      </Grid>
    </GroupBox>
    <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
      <DataGrid.Columns><DataGridTextColumn Header="Type" SortMemberPath="DeviceType" Binding="{Binding DeviceType}" Width="1.2*"/><DataGridTextColumn Header="Name" SortMemberPath="DisplayName" Binding="{Binding DisplayName}" Width="2*"/><DataGridTextColumn Header="Managed by" SortMemberPath="ManagedBy" Binding="{Binding ManagedBy}" Width="1.5*"/><DataGridTextColumn Header="IP address" SortMemberPath="IpAddress" Binding="{Binding IpAddress}" Width="*"/><DataGridTextColumn Header="MAC address" SortMemberPath="MacAddress" Binding="{Binding MacAddress}" Width="1.5*"/><DataGridTextColumn Header="Host name" SortMemberPath="Hostname" Binding="{Binding Hostname}" Width="*"/><DataGridTextColumn Header="Manufacturer" SortMemberPath="Manufacturer" Binding="{Binding Manufacturer}" Width="1.5*"/><DataGridTextColumn Header="Services" SortMemberPath="DetectedServices" Binding="{Binding DetectedServices}" Width="2*"/><DataGridCheckBoxColumn Header="Online" SortMemberPath="IsOnline" Binding="{Binding IsOnline}" Width="80"/><DataGridTextColumn Header="First seen" SortMemberPath="FirstSeenUtc" Binding="{Binding FirstSeenUtc, StringFormat={}{0:g}}" Width="1.5*"/><DataGridTextColumn Header="Last seen" SortMemberPath="LastSeenUtc" Binding="{Binding LastSeenUtc, StringFormat={}{0:g}}" Width="1.5*"/></DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
